{
  "name": "cp-analyzer-backend",
  "version": "1.0.0",
  "description": "Competitive Programming Profile Analyzer - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/all.js",
    "start:all": "node src/all.js",
    "start:api": "node src/server.js",
    "start:worker": "node src/workers/index.js",
    "start:scheduler": "node src/schedulers/index.js",
    "dev": "nodemon src/all.js",
    "dev:api": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:integration": "jest tests/integration --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "mongodb-memory-server": "^10.1.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
