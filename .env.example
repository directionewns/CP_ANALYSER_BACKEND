# Environment Configuration for Backend (Render / Production)

# Application Environment & Port
NODE_ENV=production
PORT=5000

# MongoDB Atlas Database URI (Set this in Render Environment Variables)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/competitive_analyzer?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

# Frontend Origin for CORS (e.g. https://your-app.vercel.app or comma-separated)
CLIENT_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000

# Logging & Scheduler Settings
LOG_LEVEL=info
DAILY_SYNC_HOUR=2
SYNC_TIMEZONE=UTC

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
